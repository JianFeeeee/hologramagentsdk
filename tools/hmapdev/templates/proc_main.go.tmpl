// 以下为带标志位的注入：opts 决定这次注入是否进记忆、是否据此裁剪上下文。

func (procIO) InjectTextOpts(s, c, t string, opts sdk.InjectOptions) {
	// 忽略错误：注入是 fire-and-forget，与内联路径语义一致
	_, _ = callWithTextOpts("io.injectText", s, c, t, opts)
