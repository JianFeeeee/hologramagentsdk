// shmBagFromExtra 收集 Extra 里非具名键；无额外键返回 nil。
func shmBagFromExtra(extra map[string]interface{}) map[string]interface{} {
	if len(extra) == 0 {
		return nil
	}
	var bag map[string]interface{}
	for k, v := range extra {
		if shmNamedExtraKeys[k] {
			continue
		}
		if bag == nil {
			bag = make(map[string]interface{})
		}
		bag[k] = v
	}
	return bag
}

