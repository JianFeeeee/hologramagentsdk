// procRawFiles 是 rawfile 资源的插件侧实现。
//
// ★ 它**不走 RPC**：资源就在插件进程自己的目录下（`<插件目录>/rawfile/`），
// 直接读本地文件即可。走 RPC 是错的 —— 随包资源可能有几十上百兆
// （如内置的 node 二进制），把它们搬过进程边界毫无意义。
//
// 路径来源：内核在 spawn 时注入 HA_PLUGIN_RAWFILE_DIR / HA_PLUGIN_WORK_DIR。
// 不用 cwd 推断（插件可能自己 chdir），也不读内核的 PluginDir()（那个不给插件）。
type procRawFiles struct{}

func (procRawFiles) root() string {
	if v := os.Getenv("HA_PLUGIN_RAWFILE_DIR"); v != "" {
		return v
	}
	// 回退：cwd 就是插件目录（内核 spawn 时设的 Dir）
	wd, _ := os.Getwd()
	return filepath.Join(wd, "rawfile")
}

func (r procRawFiles) workRoot() string {
	if v := os.Getenv("HA_PLUGIN_WORK_DIR"); v != "" {
		return v
	}
	wd, _ := os.Getwd()
	return filepath.Join(wd, "work")
}

// resolve 解析相对路径并拒绝穿越（与内核侧 rawFilesImpl 同一套规则）。
func (r procRawFiles) resolve(rel string) (string, error) {
	rel = strings.TrimSpace(rel)
	if rel == "" {
		return "", fmt.Errorf("rawfile 路径不能为空")
	}
	if filepath.IsAbs(rel) {
		return "", fmt.Errorf("rawfile 路径必须是相对路径: %q", rel)
	}
	root := r.root()
	clean := filepath.Clean(filepath.Join(root, rel))
	if clean != root && !strings.HasPrefix(clean, root+string(os.PathSeparator)) {
		return "", fmt.Errorf("rawfile 路径逃出资源目录: %q", rel)
	}
	return clean, nil
}

func (r procRawFiles) Read(rel string) ([]byte, error) {
	p, err := r.resolve(rel)
	if err != nil {
		return nil, err
	}
	b, err := os.ReadFile(p)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, fmt.Errorf("rawfile 不存在: %s（打包时是否漏了 rawfile/ 或 plg.json 的 rawfiles？）", rel)
		}
		return nil, err
	}
	return b, nil
}

func (r procRawFiles) List(rel string) ([]string, error) {
	p, err := r.resolve(rel)
	if err != nil {
		return nil, err
	}
	entries, err := os.ReadDir(p)
	if err != nil {
		return nil, err
	}
	out := make([]string, 0, len(entries))
	for _, e := range entries {
		name := e.Name()
		if e.IsDir() {
			name += "/"
		}
		out = append(out, name)
	}
	sort.Strings(out)
	return out, nil
}

func (r procRawFiles) Exists(rel string) bool {
	p, err := r.resolve(rel)
	if err != nil {
		return false
	}
	st, err := os.Stat(p)
	return err == nil && !st.IsDir()
}

func (r procRawFiles) Dir() string { return r.root() }

func (r procRawFiles) WorkDir() string {
	d := r.workRoot()
	_ = os.MkdirAll(d, 0o755)
	return d
}

var _ sdk.RawFilesAPI = procRawFiles{}

